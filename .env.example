# Copy to .env locally; never commit the populated file.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRIDPILOT_DB_PATH=var/runs.sqlite3
# Required (>=24 characters) when GRIDPILOT_ENV=production.
GRIDPILOT_API_TOKEN=
GRIDPILOT_TIMEOUT_SECONDS=90
GRIDPILOT_AGENT_CALLABLE=agent:run_investigation
GRIDPILOT_SOLVE_CALLABLE=backend.p3_adapter:solve
GRIDPILOT_VALIDATE_CALLABLE=backend.p3_adapter:validate
GEMINI_API_KEY=
# Set only if live CEN retrieval is implemented later; runtime demo needs no CEN key.
CEN_API_KEY=
