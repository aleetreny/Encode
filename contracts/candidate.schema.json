{
  "$defs": {
    "AddBattery": {
      "additionalProperties": false,
      "properties": {
        "energy_mwh": {
          "exclusiveMinimum": 0,
          "title": "Energy Mwh",
          "type": "number"
        },
        "node_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Node Id",
          "type": "string"
        },
        "power_mw": {
          "exclusiveMinimum": 0,
          "title": "Power Mw",
          "type": "number"
        },
        "type": {
          "const": "add_battery",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "node_id",
        "power_mw",
        "energy_mwh"
      ],
      "title": "AddBattery",
      "type": "object"
    },
    "UprateLine": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
          "title": "Line Id",
          "type": "string"
        },
        "new_capacity_mw": {
          "exclusiveMinimum": 0,
          "title": "New Capacity Mw",
          "type": "number"
        },
        "type": {
          "const": "uprate_line",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "line_id",
        "new_capacity_mw"
      ],
      "title": "UprateLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 1000,
      "title": "Description",
      "type": "string"
    },
    "modifications": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_battery": "#/$defs/AddBattery",
            "uprate_line": "#/$defs/UprateLine"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AddBattery"
          },
          {
            "$ref": "#/$defs/UprateLine"
          }
        ]
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Modifications",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "modifications"
  ],
  "title": "Candidate",
  "type": "object"
}
