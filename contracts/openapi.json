          "live_gemini": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Live Gemini"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "output_summary": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Summary"
          },
          "scope": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          },
          "status": {
            "enum": [
              "started",
              "success",
              "failed",
              "retry"
            ],
            "title": "Status",
            "type": "string"
          },
          "timestamp_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp Utc"
          },
          "tool": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "status"
        ],
        "title": "ToolEvent",
        "type": "object"
      },
      "ValidateRequest": {
        "additionalProperties": false,
        "properties": {
          "options": {
            "$ref": "#/components/schemas/Options"
          },
          "scenario_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "title": "Scenario Id",
            "type": "string"
          },
          "solution": {
            "$ref": "#/components/schemas/Solution"
          }
        },
        "required": [
          "scenario_id",
          "solution"
        ],
        "title": "ValidateRequest",
        "type": "object"
      },
      "Validation": {
        "additionalProperties": false,
        "properties": {
          "max_residual_mw": {
            "minimum": 0.0,
            "title": "Max Residual Mw",
            "type": "number"
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Metrics"
              },
              {
                "type": "null"
              }
            ]
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          },
          "violations": {
            "items": {
              "type": "string"
            },
            "title": "Violations",
            "type": "array"
          }
        },
        "required": [
          "passed",
          "violations",
          "max_residual_mw"
        ],
        "title": "Validation",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
